/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dink-proxy",
	"main": "src/index.js",
	"compatibility_date": "2026-05-04",
	"observability": {
		"enabled": true
	},
	// Drain backstop for vs_dink_drops (see the site's docs/LIVE-UPDATES.md): every minute
	// a plain drain bounds worst-case credit latency at ~60s even if an after-insert ping
	// was lost; every 15 minutes the drain also reconciles recent un-credited drops whose
	// situation may have changed (e.g. a player who signed up after their drop). The
	// scheduled handler branches on which cron fired. No-ops until SITE_URL and the
	// DINK_PROCESS_SECRET secret are configured.
	"triggers": {
		"crons": ["* * * * *", "*/15 * * * *"]
	},
	// Non-secret config. Set SUPABASE_KEY (service-role or anon w/ insert RLS) as a
	// SECRET via `npx wrangler secret put SUPABASE_KEY` — never commit it here.
	// VALID_TOKENS and WEBHOOK_* are also secrets managed by the bot / by hand.
	"vars": {
		// Discord feed policy: forward LOOT to the achievements webhook only when the
		// total drop value clears this. Active events' tracked items reach the proxy via
		// Dink's loot allowlist (injected in handleConfig), so cheap tracked items are
		// recorded for bingo but not forwarded to the channel.
		"FEED_MIN_VALUE": "3000000",
		// Supabase REST base, e.g. https://<project>.supabase.co . Leave blank to
		// disable auto-tracking (the proxy then behaves exactly as before).
		"SUPABASE_URL": "https://rrnmckaabbvtkkpoeefg.supabase.co",
		// The site that drains vs_dink_drops — its CANONICAL origin (an off-canonical host
		// would 308 the drain ping). Used by the after-insert ping and the cron backstop;
		// leave blank to disable both (drops then wait for the site's poll-on-read
		// backstop, exactly the pre-pipeline behaviour). Requires the DINK_PROCESS_SECRET
		// secret: `npx wrangler secret put DINK_PROCESS_SECRET` — same value as the Fly
		// app's DINK_PROCESS_SECRET.
		"SITE_URL": "",
		// Manifest cache TTL (ms) in the isolate global.
		"MANIFEST_TTL_MS": "30000",
		// Per-user token cache TTL (ms). Tokens are minted/revoked in the dink_tokens
		// table by the bot and the site; the proxy validates against that set (unioned
		// with VALID_TOKENS) and a mint/revoke takes effect within this TTL.
		"TOKENS_TTL_MS": "30000",
		// Dink config template cache TTL (ms). The template is admin-editable on the
		// site (bot_config row 'dink_config'); served here with the bundled JSON as
		// fallback. Clients re-fetch /config periodically, so edits propagate within
		// this TTL + the client's refetch interval — no redeploy needed.
		"CONFIG_TTL_MS": "60000",
		// Per-token tracked-item cache. TTL is the fresh-refresh window; STALE is how long
		// a member's OWN last-good item list may still be served if a vs_dink_token_items
		// read fails (never the clan-wide union). After STALE with no success, serve none.
		"TOKEN_ITEMS_TTL_MS": "60000",
		"TOKEN_ITEMS_STALE_MS": "1800000"
	}
}
